<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>FindLiteAI.Storage.LiteDb</PackageId>
    <Title>FindLiteAI.Storage.LiteDb</Title>
    <Description>
      LiteDB embedded storage provider for FindLiteAI offline AI-powered semantic, keyword, and hybrid search.
    </Description>
    <PackageTags>
      ai;litedb;embedded-database;semantic-search;hybrid-search;offline-ai;vector-search;search-engine;dotnet
    </PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteDB"
                      Version="5.0.21" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"
                      Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FindLiteAI.Core\FindLiteAI.Core.csproj" />
  </ItemGroup>

</Project>
