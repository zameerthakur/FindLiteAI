<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>FindLiteAI.Embeddings.Onnx</PackageId>
    <Title>FindLiteAI.Embeddings.Onnx</Title>
    <Description>
      ONNX Runtime embedding provider for FindLiteAI offline AI-powered semantic, keyword, and hybrid search.
    </Description>
    <PackageTags>
      ai;onnx;onnxruntime;embeddings;semantic-search;hybrid-search;offline-ai;vector-search;dotnet
    </PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"
                      Version="8.0.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime"
                      Version="1.26.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers"
                      Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FindLiteAI.Core\FindLiteAI.Core.csproj" />
  </ItemGroup>

</Project>