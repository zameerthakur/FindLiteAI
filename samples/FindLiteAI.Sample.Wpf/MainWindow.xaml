<Window x:Class="FindLiteAI.Sample.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FindLiteAI WPF Sample"
        Height="680"
        Width="960"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,16">
            <TextBlock Text="FindLiteAI WPF Sample"
                       FontSize="26"
                       FontWeight="SemiBold" />

            <TextBlock Text="Offline AI-powered semantic, keyword, and hybrid search for desktop applications."
                       Margin="0,6,0,0"
                       Foreground="Gray" />
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="Model:" />

            <ComboBox x:Name="ModelComboBox"
                      Grid.Column="1"
                      Height="36"
                      DisplayMemberPath="DisplayName" />

            <Button x:Name="LoadModelButton"
                    Grid.Column="2"
                    Margin="10,0,0,0"
                    Content="Load Model"
                    Height="36"
                    Click="LoadModelButton_Click" />
        </Grid>

        <Grid Grid.Row="2"
              Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchTextBox"
                     Grid.Column="0"
                     Height="38"
                     VerticalContentAlignment="Center"
                     FontSize="15"
                     Text="login issue"
                     KeyDown="SearchTextBox_KeyDown" />

            <Button x:Name="SearchButton"
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    Content="Search"
                    Height="38"
                    Click="SearchButton_Click" />
        </Grid>

        <DataGrid x:Name="ResultsGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Rank"
                                    Binding="{Binding Rank}"
                                    Width="70" />

                <DataGridTextColumn Header="Score"
                                    Binding="{Binding Score}"
                                    Width="120" />

                <DataGridTextColumn Header="Id"
                                    Binding="{Binding Id}"
                                    Width="140" />

                <DataGridTextColumn Header="Text"
                                    Binding="{Binding Text}"
                                    Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="4"
                   Margin="0,14,0,0"
                   Foreground="Gray"
                   Text="Select a model and click Load Model." />
    </Grid>
</Window>
