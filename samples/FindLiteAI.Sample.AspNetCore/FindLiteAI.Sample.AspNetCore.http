@FindLiteAI_HostAddress = https://localhost:7014

### Root Health Check

GET {{FindLiteAI_HostAddress}}/
Accept: application/json

###

### FindLiteAI API Health Check

GET {{FindLiteAI_HostAddress}}/api/findliteai/health
Accept: application/json

###

### Add Document - Login Failure

POST {{FindLiteAI_HostAddress}}/api/findliteai/collections/logs/documents
Content-Type: application/json

{
  "id": "log-1",
  "text": "SFTP authentication failed for remote user.",
  "metadata": {
    "module": "SFTP",
    "severity": "High"
  }
}

###

### Add Document - Database Timeout

POST {{FindLiteAI_HostAddress}}/api/findliteai/collections/logs/documents
Content-Type: application/json

{
  "id": "log-2",
  "text": "SQL database timeout occurred while executing query.",
  "metadata": {
    "module": "Database",
    "severity": "Medium"
  }
}

###

### Add Document - Email Relay

POST {{FindLiteAI_HostAddress}}/api/findliteai/collections/logs/documents
Content-Type: application/json

{
  "id": "log-3",
  "text": "SMTP email relay accepted outgoing message.",
  "metadata": {
    "module": "SMTP",
    "severity": "Low"
  }
}

###

### Batch Add Documents

POST {{FindLiteAI_HostAddress}}/api/findliteai/collections/logs/documents/batch
Content-Type: application/json

{
  "documents": [
    {
      "id": "log-4",
      "text": "User password validation failed during SSH login.",
      "metadata": {
        "module": "SSH",
        "severity": "High"
      }
    },
    {
      "id": "log-5",
      "text": "Database connection pool exhausted.",
      "metadata": {
        "module": "Database",
        "severity": "Medium"
      }
    }
  ]
}

###

### Hybrid Search - SSH Login

POST {{FindLiteAI_HostAddress}}/api/findliteai/collections/logs/search
Content-Type: application/json

{
  "query": "ssh login",
  "searchMode": "Hybrid",
  "maxResults": 5,
  "minimumScore": 0.10
}

###

